# ASTRA Configuration Template (.env.example)
# 100% Cloud-Agnostic Configuration (Docker Compose, Kubernetes, On-Premises, or any Cloud VM).
# Copy to .env for local development. Never commit real credentials or private keys.

ASTRA_ENV=development
ASTRA_EXECUTION_POLICY=local-no-egress
ASTRA_BANNER_MODE=DEMO

# Database, Queue & Cloud-Agnostic Object Storage (MinIO / Ceph / POSIX / S3-Compatible)
DATABASE_URL=postgresql://astra:astra_local_dev_only@localhost:5432/astra
REDIS_URL=redis://localhost:6379/0
ASTRA_BLOB_BACKEND=local
ASTRA_BLOB_LOCAL_DIR=./data/blobs
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_BUCKET_NAME=astra-local-synthetic-blobs
OBJECT_STORAGE_REGION=local
VAULT_ADDR=http://localhost:8200
ASTRA_ENCRYPTION_AT_REST=true
ASTRA_KMS_KEY_OWNER=customer-security-admin

# Authentication & OIDC (Production requires real OIDC issuer; dev login fails closed in production)
ASTRA_AUTH_MODE=dev_persona
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
SESSION_SECRET_KEY=replace_with_32_byte_random_hex_in_local_env

# ERP Integration Defaults (Mock ERP enabled by default for offline IT evaluation)
ERP_DEFAULT_ADAPTER=mock_multi_erp
MOCK_ERP_BASE_URL=http://localhost:8081
SAP_S4_BASE_URL=
ORACLE_ERP_BASE_URL=
NETSUITE_ACCOUNT_ID=
NETSUITE_BASE_URL=
ODOO_RPC_URL=
SAGE_API_URL=

# Optional Integrations (Disabled or mocked by default)
STRIPE_TEST_WEBHOOK_SECRET=
PINAKA_MODE=mock
PINAKA_API_BASE_URL=
LAYA_REASON_CLASSIFIER_ENABLED=false
LAYA_PYTHON_BIN=
UNLIMITED_OCR_ENABLED=false

# Outbound Mail Sink (Local sink by default; live sends require explicit admin approval)
MAIL_PROVIDER=local_sink
MAIL_SINK_DIR=./data/mail_sink

# LLM Provider (Cloud-Agnostic: deterministic_local, ollama_vllm, openai, anthropic, gemini)
LLM_PROVIDER=deterministic_local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ALIAS=astra-grounded-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
